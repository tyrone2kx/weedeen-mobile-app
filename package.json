{
  "name": "com.tyrotech.weedeenapp",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "build": "react-native run-android --mode release",
    "clean": "yarn clean:android && yarn clean:ios",
    "clean:android": "cd android && ./gradlew clean",
    "clean:ios": "cd ios && pod deintegrate",
    "debug": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res && cd android && ./gradlew assembleDebug",
    "format": "prettier --write 'src/**/*.{js,ts,tsx}'",
    "format:ci": "prettier --check src/**/*.ts{,x}",
    "format-client": "prettier --write src/generated",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "generate-client": "openapi --input http://localhost:5001/api-docs-json --output ./src/generated --useOptions --useUnionTypes --request ./src/api/request.ts --client axios && yarn format-client",
    "pod-install": "cd ios && pod install",
    "release:assemble": "cd android && ./gradlew assembleRelease",
    "release:bundle": "cd android && ./gradlew bundleRelease",
    "start": "react-native start --reset-cache",
    "test": "jest"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.2.8",
    "@notifee/react-native": "^9.1.8",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "^8.5.1",
    "@react-native-community/geolocation": "^3.4.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-firebase/analytics": "^23.7.0",
    "@react-native-firebase/app": "^23.7.0",
    "@react-native-firebase/crashlytics": "^23.7.0",
    "@react-native-firebase/messaging": "^23.7.0",
    "@react-native/new-app-screen": "0.82.1",
    "@react-navigation/bottom-tabs": "^7.8.12",
    "@react-navigation/native": "^7.1.25",
    "@react-navigation/native-stack": "^7.8.6",
    "@reduxjs/toolkit": "^2.11.1",
    "@tanstack/react-query": "^5.90.12",
    "axios": "^1.13.2",
    "formik": "^2.4.9",
    "lucide-react-native": "^0.556.0",
    "moment": "^2.30.1",
    "nativewind": "^4.2.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "react": "19.1.1",
    "react-native": "0.82.1",
    "react-native-bootsplash": "^6.3.11",
    "react-native-file-access": "^3.2.0",
    "react-native-gesture-handler": "^2.29.1",
    "react-native-haptic-feedback": "^2.3.3",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-nitro-modules": "^0.31.10",
    "react-native-phone-number-input": "^2.1.0",
    "react-native-reanimated": "^4.2.0",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "^4.18.0",
    "react-native-svg": "^15.15.1",
    "react-native-toast-message": "^2.3.3",
    "react-native-uuid": "^2.0.3",
    "react-native-vector-icons": "^10.3.0",
    "react-native-video": "^7.0.0-alpha.12",
    "react-native-webview": "^13.16.0",
    "react-native-worklets": "^0.7.1",
    "react-redux": "^9.2.0",
    "redux": "^5.0.1",
    "redux-persist": "^6.0.0",
    "semver": "^7.7.3",
    "tailwindcss": "^3.4.18",
    "use-debounce": "^10.0.6",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.82.1",
    "@react-native/eslint-config": "0.82.1",
    "@react-native/metro-config": "0.82.1",
    "@react-native/typescript-config": "0.82.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.1.1",
    "@types/react-test-renderer": "^19.1.0",
    "babel-jest": "^30.2.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^8.19.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jest": "^29.6.3",
    "openapi-typescript-codegen": "^0.29.0",
    "prettier": "^3.7.4",
    "react-native-dotenv": "^3.4.11",
    "react-test-renderer": "19.1.1",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
